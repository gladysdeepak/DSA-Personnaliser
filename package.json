{
  "name": "dsa-personaliser",
  "version": "1.0.0",
  "description": "Personalized DSA Learning & Concept Diagnosis Platform",
  "main": "server/index.js",
  "scripts": {
    "server": "nodemon --ignore server/data/leetcode_quality_report.json server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
